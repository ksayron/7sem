        </mxCell>
        <mxCell id="topdown_c31" value="Включаем обе границы периода:&lt;br&gt;до начала берём A − 1, до конца — B.&lt;br&gt;День T не входит в F(n)." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fillColor=#F5F7F9;strokeColor=none;align=left;fontSize=17;spacing=20;">
