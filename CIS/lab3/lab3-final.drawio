        <mxCell id="loop_c12" value="Вывести «Ошибка входных дат»" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=25;">
          <mxGeometry as="geometry" x="980" y="455" width="440" height="80" />
