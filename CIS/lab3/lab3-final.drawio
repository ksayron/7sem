            <mxPoint as="targetPoint" x="1550" y="1678" />
          </mxGeometry>
        </mxCell>
        <mxCell id="loop_c5" value="CIS · Лабораторная работа 3" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=none;spacing=0;align=left;fontSize=12;fontStyle=0;fontColor=#657786;">
          <mxGeometry as="geometry" x="50" y="1690" width="600" height="24" />
        </mxCell>
        <mxCell id="loop_c6" value="03 / 05" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=none;spacing=0;align=right;fontSize=12;fontStyle=0;fontColor=#657786;">
          <mxGeometry as="geometry" x="1430" y="1690" width="120" height="24" />
        </mxCell>
        <mxCell id="loop_c7" value="ПРАВИЛО ДЛЯ ОДНОГО ДНЯ&lt;br&gt;&lt;br&gt;T — последний рабочий день перед выходными.&lt;br&gt;r = (d − T) mod 4&lt;br&gt;&lt;br&gt;r = 0 или r = 3 → рабочий день&lt;br&gt;r = 1 или r = 2 → выходной" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rounded=0;fillColor=#EDF4F8;strokeColor=none;align=left;fontSize=18;spacing=20;">
          <mxGeometry as="geometry" x="980" y="180" width="480" height="220" />
        </mxCell>
        <mxCell id="loop_c8" value="ДАТЫ И ГРАНИЦЫ&lt;br&gt;&lt;br&gt;A — начало периода; B — конец периода.&lt;br&gt;Границы A и B включаются в расчёт.&lt;br&gt;Разность дат вычисляется в календарных днях.&lt;br&gt;Праздники отдельно не учитываются." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rounded=0;fillColor=#F5F7F9;strokeColor=none;align=left;fontSize=17;spacing=20;">
          <mxGeometry as="geometry" x="980" y="620" width="480" height="190" />
        </mxCell>
        <mxCell id="loop_c9" value="Начало" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=50;fillColor=#EDF4F8;strokeColor=#315C7A;fontStyle=1;">
          <mxGeometry as="geometry" x="410" y="180" width="280" height="55" />
        </mxCell>
        <mxCell id="loop_c10" value="Ввести даты A, B, T" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=25;">
          <mxGeometry as="geometry" x="330" y="285" width="440" height="80" />
        </mxCell>
        <mxCell id="loop_c11" value="A ≤ B&lt;br&gt;и T &amp;lt; A?" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rhombus;perimeter=rhombusPerimeter;fontSize=17;spacing=2;">
          <mxGeometry as="geometry" x="350" y="420" width="400" height="140" />
