        <mxCell id="loop_c13" value="Конец" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=50;fillColor=#EDF4F8;strokeColor=#315C7A;fontStyle=1;">
          <mxGeometry as="geometry" x="1060" y="555" width="280" height="50" />
        </mxCell>
        <mxCell id="loop_c14" value="d := A&lt;br&gt;W := 0" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rounded=0;">
          <mxGeometry as="geometry" x="330" y="625" width="440" height="80" />
        </mxCell>
        <mxCell id="loop_c15" value="d ≤ B?" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rhombus;perimeter=rhombusPerimeter;fontSize=17;spacing=2;">
          <mxGeometry as="geometry" x="370" y="780" width="360" height="120" />
        </mxCell>
        <mxCell id="loop_c16" value="r := (d − T) mod 4" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;rounded=0;">
