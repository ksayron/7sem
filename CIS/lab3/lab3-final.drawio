        <mxCell id="function_c26" value="ПОЛНЫЙ ЦИКЛ ПОСЛЕ T&lt;br&gt;&lt;br&gt;1-й день: отдых&lt;br&gt;2-й день: отдых&lt;br&gt;3-й день: работа&lt;br&gt;4-й день: работа&lt;br&gt;&lt;br&gt;Каждые 4 дня дают 2 рабочих." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;fillColor=#EDF4F8;strokeColor=none;align=left;fontSize=18;spacing=22;">
