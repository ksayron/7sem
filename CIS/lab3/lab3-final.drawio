    <mxGraphModel dx="1600" dy="1740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1740" math="0" shadow="0" background="#FFFFFF">
      <root>
