        </mxCell>
        <mxCell id="loop_c3" value="Сначала определить признак рабочего дня, затем применить его в цикле по всем датам периода" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=none;spacing=0;align=left;fontSize=16;fontStyle=0;fontColor=#657786;">
          <mxGeometry as="geometry" x="50" y="112" width="1500" height="30" />
        </mxCell>
        <mxCell id="loop_e4" parent="1" edge="1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=1;strokeColor=#253746;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#253746;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;strokeColor=#CBD5DD;">
