        <mxCell id="loop_c1" value="ЛАБОРАТОРНАЯ РАБОТА 3  /  ВАРИАНТ 8" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#253746;strokeColor=#253746;strokeWidth=1.5;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=10;text;strokeColor=none;fillColor=none;spacing=0;align=left;fontSize=13;fontStyle=0;fontColor=#657786;">
