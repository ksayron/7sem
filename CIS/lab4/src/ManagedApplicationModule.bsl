Процедура ПриНачалеРаботыСистемы()

    ПоприветствоватьПользователя("Добро пожаловать!", "Пользователь");
    РезультатВозведенияВСтепеньДоГраницы(2, 3, 10);
    ПодсчетЧислаДней(Дата(2026, 11, 2), Дата(2026, 11, 8));

    // Дополнительные примеры: параметр запуска /C Проверка.
    Если ПараметрЗапуска = "Проверка" Тогда
        Сообщить("Проверка: результат равен границе (8 = 8).");
        РезультатВозведенияВСтепеньДоГраницы(2, 3, 8);
        Сообщить("Проверка: результат превышает границу (16 > 10).");
        РезультатВозведенияВСтепеньДоГраницы(2, 4, 10);
        Сообщить("Проверка: один рабочий день.");
        ПодсчетЧислаДней(Дата(2026, 11, 2), Дата(2026, 11, 2));
        Сообщить("Проверка: один выходной день.");
        ПодсчетЧислаДней(Дата(2026, 11, 8), Дата(2026, 11, 8));
        Сообщить("Проверка: время не влияет на подсчет дней.");
        ПодсчетЧислаДней(Дата(2026, 11, 2, 23, 59, 59), Дата(2026, 11, 8, 1, 0, 0));
        Сообщить("Проверка: обратный интервал.");
        ПодсчетЧислаДней(Дата(2026, 11, 8), Дата(2026, 11, 2));
    КонецЕсли;

КонецПроцедуры

Процедура ПоприветствоватьПользователя(Приветствие, Пользователь)

    Сообщить(Пользователь + "! " + Приветствие);

КонецПроцедуры

Процедура РезультатВозведенияВСтепеньДоГраницы(Число, Степень, Граница)

    Результат = Pow(Число, Степень);
    Если Результат < Граница Тогда
        Сообщить(Строка(Результат));
    Иначе
        Сообщить("Результат превышает верхнюю границу в " + Строка(Граница));
    КонецЕсли;

КонецПроцедуры

Процедура ПодсчетЧислаДней(ДатаНачало, ДатаКонец)

    // Работаем с локальными переменными, не изменяя переданные параметры.
    ТекущаяДатаИнтервала = НачалоДня(ДатаНачало);
    КонечнаяДатаИнтервала = НачалоДня(ДатаКонец);
    Если ТекущаяДатаИнтервала > КонечнаяДатаИнтервала Тогда
        Сообщить("Ошибка: дата начала позже даты конца.");
        Возврат;
    КонецЕсли;

    РабочиеДни = 0;
    ВыходныеДни = 0;
    Пока ТекущаяДатаИнтервала <= КонечнаяДатаИнтервала Цикл
        // ДеньНедели(): 1 — понедельник, 7 — воскресенье.
        Если ДеньНедели(ТекущаяДатаИнтервала) <= 5 Тогда
            РабочиеДни = РабочиеДни + 1;
        Иначе
            ВыходныеДни = ВыходныеДни + 1;
        КонецЕсли;
        ТекущаяДатаИнтервала = ТекущаяДатаИнтервала + 86400;
    КонецЦикла;

    Сообщить("Рабочих дней: " + Строка(РабочиеДни)
        + ". Выходных дней: " + Строка(ВыходныеДни));

КонецПроцедуры
