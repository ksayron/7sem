          <mxGeometry x="540" y="370" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc6" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Пройти учебную&lt;br&gt;сессию" vertex="1" useCase="6" requirements="FR06, FR08" description="Пройти сессию на 3, 5 или 10 заданий; приостановить её, пропустить задание или завершить. Выбрать обычную практику, интенсивный или экзаменационный режим.">
