        </mxCell>
        <mxCell id="uc7" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Выполнить упражнение" vertex="1" useCase="7" requirements="FR03, FR07" description="Предоставить ответ на закреплённую версию упражнения; получить детерминированную проверку объективного ответа либо явно обозначенную самооценку.">
          <mxGeometry x="540" y="540" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc8" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Сохранить попытку,&lt;br&gt;результат и помощь" vertex="1" useCase="8" requirements="FR07, FR13" description="Зафиксировать ответ, версию упражнения, вид результата и использованную помощь; не приравнивать самооценку к объективному доказательству знания.">
          <mxGeometry x="1070" y="540" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc9" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Получить подсказку" vertex="1" useCase="9" requirements="FR07" description="По запросу раскрыть авторскую подсказку или эталон и сохранить факт помощи, если режим допускает её.">
          <mxGeometry x="810" y="455" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc10" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Запросить объяснение&lt;br&gt;ИИ по ответу" vertex="1" useCase="10" requirements="FR24; ПТ-04" description="После результата по запросу получить отдельную модельную интерпретацию; отсутствие ИИ не блокирует упражнение.">
          <mxGeometry x="810" y="620" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc11" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Просмотр истории,&lt;br&gt;свидетельств и профиля" vertex="1" useCase="11" requirements="FR13; ПТ-03" description="Просмотреть личные попытки и наблюдения с источником, условиями, уровнем помощи и состоянием; различить модельную оценку и одобренный факт.">
          <mxGeometry x="540" y="700" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc12" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Повторить тему&lt;br&gt;по рекомендации" vertex="1" useCase="12" requirements="FR09" description="Выбрать рекомендованное повторение, перенести или отклонить его; выполнить практику по выбранной теме.">
          <mxGeometry x="540" y="785" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc13" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Вести рабочие&lt;br&gt;и учебные эпизоды" vertex="1" useCase="13" requirements="FR10" description="Создать, исправить или архивировать эпизод, указать контекст, личную роль, ограничения и вклад.">
          <mxGeometry x="540" y="870" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc14" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Обсудить контекст&lt;br&gt;и инженерные&lt;br&gt;решения" vertex="1" useCase="14" requirements="FR11" description="Уточнить цель и ограничения, сохранить объяснения принятых решений, альтернативы и нерешённые вопросы.">
          <mxGeometry x="540" y="955" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc15" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Подтвердить&lt;br&gt;рассмотренную версию&lt;br&gt;контекста" vertex="1" useCase="15" requirements="FR12" description="Явно подтвердить точный снимок контекста и рассмотренное обсуждение; подтверждение не доказывает безусловную правильность решений.">
          <mxGeometry x="540" y="1040" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc16" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Оспорить, исправить&lt;br&gt;или отозвать&lt;br&gt;наблюдение" vertex="1" useCase="16" requirements="FR14" description="При просмотре выбранного наблюдения подать возражение, исправить сведения или отозвать наблюдение, сохранив его происхождение и историю.">
          <mxGeometry x="830" y="700" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc17" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Запросить&lt;br&gt;интерпретацию&lt;br&gt;контекста у ИИ" vertex="1" useCase="17" requirements="FR24; ПТ-04" description="По запросу получить отдельную интерпретацию разрешённого рабочего контекста и затем самостоятельно оценить её.">
          <mxGeometry x="830" y="970" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc18" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Создать и&lt;br&gt;редактировать запись&lt;br&gt;опыта" vertex="1" useCase="18" requirements="FR15–FR16" description="Создать запись вручную либо из эпизода и свидетельств; вести редакции контекста, действий, личного вклада и результата.">
          <mxGeometry x="540" y="1150" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc19" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Запросить черновик&lt;br&gt;опыта у ИИ" vertex="1" useCase="19" requirements="FR15, FR24" description="По запросу получить редактируемый черновик из выбранной активности. ИИ не подтверждает факты и не заменяет решение владельца.">
          <mxGeometry x="830" y="1150" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc20" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Подтвердить точную&lt;br&gt;редакцию опыта" vertex="1" useCase="20" requirements="FR16" description="Рассмотреть факты, вклад и известный результат и одобрить текущую точную редакцию. Изменение фактов создаёт новый неподтверждённый черновик.">
          <mxGeometry x="540" y="1235" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc21" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Подготовить и&lt;br&gt;репетировать рассказ" vertex="1" useCase="21" requirements="FR17" description="Подготовить представление опыта для собеседования или ревью, отредактировать и отдельно просмотреть точную версию рассказа.">
          <mxGeometry x="540" y="1320" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc22" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Экспортировать&lt;br&gt;проверенный рассказ" vertex="1" useCase="22" requirements="FR17" description="Сохранить выбранную проверенную версию рассказа, основанную на одобренной редакции опыта; устаревшее одобрение не применяется к новым фактам.">
          <mxGeometry x="540" y="1405" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc23" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Вести каталог&lt;br&gt;понятий и их связей" vertex="1" useCase="23" requirements="FR01" description="Создавать понятия, связи и предпосылки; каталог не ограничивается одним языком программирования.">
          <mxGeometry x="540" y="1780" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc24" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Подготовить версии&lt;br&gt;материалов и&lt;br&gt;упражнений" vertex="1" useCase="24" requirements="FR02–FR03" description="Подготовить материалы, упражнения шести типов, ответы, правила проверки, подсказки, переводы и маршруты.">
          <mxGeometry x="780" y="1760" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc25" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Проверить и&lt;br&gt;опубликовать контент" vertex="1" useCase="25" requirements="FR02–FR03" description="Опубликовать корректную проверенную версию; уже назначенные упражнения и прежние результаты продолжают ссылаться на старые версии.">
          <mxGeometry x="1030" y="1780" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc26" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Вывести дефектный&lt;br&gt;контент из&lt;br&gt;использования" vertex="1" useCase="26" requirements="FR02" description="Исключить версию из новых сессий и пакетов, сохранив старые попытки и историю.">
          <mxGeometry x="780" y="1855" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc27" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Управлять учётными&lt;br&gt;записями и ролями" vertex="1" useCase="27" requirements="FR18" description="Управлять учётными записями, доступом и назначением ролей; административные права не дают права подтверждать чужой опыт.">
          <mxGeometry x="730" y="-130" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc28" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Контроль системы,&lt;br&gt;резервное копирование&lt;br&gt;и восстановление" vertex="1" useCase="28" requirements="FR22" description="Контролировать приложение, БД и очереди; настраивать эксплуатационные параметры и ИИ-маршрут, вести безопасный аудит, создавать и проверять резервные копии и восстановление.">
          <mxGeometry x="1070" y="-130" width="173.46" height="90" as="geometry" />
        </mxCell>
        <mxCell id="uc29" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Загрузить учебный&lt;br&gt;пакет" vertex="1" useCase="29" requirements="FR20; СТ-ОФЛ-01" description="Загрузить полный пакет закреплённых версий материалов; проверить целостность перед активацией.">
          <mxGeometry x="540" y="1500" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc30" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Выполнить&lt;br&gt;упражнение без сети" vertex="1" useCase="30" requirements="FR20; СТ-ОФЛ-02, СТ-ОФЛ-08" description="Выполнить упражнение по ранее загруженному пакету и сохранить попытку локально. Авторские подсказки доступны; новая модельная оценка требует подключения и отдельного запроса.">
          <mxGeometry x="540" y="1585" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc31" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Синхронизировать&lt;br&gt;личные данные" vertex="1" useCase="31" requirements="FR20–FR21; ПТ-02" description="Передать локальные операции и получить изменения; повторная отправка не создаёт дубликаты, статусы принятия и конфликта видны пользователю.">
          <mxGeometry x="540" y="1670" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc32" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Разрешить конфликт&lt;br&gt;версий" vertex="1" useCase="32" requirements="FR21; СТ-ОФЛ-06" description="При конфликте выбрать либо объединить сохранённые черновики; подтверждение применяется только к явно выбранной версии.">
          <mxGeometry x="830" y="1670" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc33" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Проверить ответы,&lt;br&gt;версии и связи&lt;br&gt;контента" vertex="1" useCase="33" requirements="FR02–FR03" description="Обязательно проверить корректность опубликованных ответов, правила проверки и ссылки на понятия и версии.">
          <mxGeometry x="1110" y="1860" width="173.46" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc34" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Просмотреть и разрешить&lt;br&gt;передачу контекста" vertex="1" useCase="34" requirements="FR19, FR24; ПТ-04" description="Показать минимальные данные и ИИ-маршрут перед внешней передачей, исключить ненужное или отменить запрос. Предыдущее разрешение учитывается только для того же состава и назначения.">
          <mxGeometry x="1110" y="850" width="173.46" height="90" as="geometry" />
        </mxCell>
        <mxCell id="uc35" parent="1" style="ellipse;whiteSpace=wrap;html=1;shadow=0;glass=0;sketch=0;strokeColor=default;strokeWidth=1;fillColor=default;gradientColor=none;" value="Проверить одобрение&lt;br&gt;редакции опыта&lt;br&gt;и версии рассказа" vertex="1" useCase="35" requirements="FR16–FR17" description="Проверить точную одобренную редакцию опыта и отдельный просмотр экспортируемого материала. При отсутствии подходящего одобрения экспорт блокируется; система не одобряет факты автоматически.">
