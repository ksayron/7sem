        <mxCell id="sync-rules" value="Правила синхронизации&#10;&#10;Повтор: тот же OperationId и PayloadHash.&#10;Конфликт версии: данные сохраняются до выбора.&#10;Локальная операция может не иметь чека.&#10;Пакет ссылается на закреплённые версии.&#10;Ключ чека: (OwnerId, OperationId)." style="whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=23;fontColor=#000000;fontStyle=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;shape=note;align=left;spacing=12;" vertex="1" parent="1" kind="note">
          <mxGeometry x="690" y="1080" width="1040" height="215" as="geometry" />
        </mxCell>
        <mxCell id="note-1315" value="RoleName: Developer, ContentAuthor, SystemAdministrator. Роли не являются подклассами UserAccount.&#10;Автономный контур относится к целевой системе; загрузка и синхронизация требуют соединения с сервером." style="whiteSpace=wrap;html=0;fontFamily=Times New Roman;fontSize=21;fontColor=#000000;fontStyle=0;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;shape=note;align=left;spacing=12;" vertex="1" parent="1" kind="note">
          <mxGeometry x="45" y="1315" width="1710" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
