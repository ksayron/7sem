				<column name="PublishedAt" />
				<column name="OccurredAt" />
			</index>
		</table>
	</schema>
	<schema name="public" catalogname="concurrency_lab_db" >
		<comment><![CDATA[standard public schema]]></comment>
		<table name="lab_copies" row_count="120" spec="" >
			<comment><![CDATA[Изолированные учебные данные. CHECK ReservedPoints >= 0. Не ссылается на реальные книги и пользователей.]]></comment>
			<column name="Id" type="uuid" mandatory="y" />
			<column name="Title" type="varchar" length="200" mandatory="y" />
			<column name="Available" type="boolean" mandatory="y" />
			<column name="ReservedPoints" type="integer" length="32" mandatory="y" />
			<index name="PK_lab_copies" unique="PRIMARY_KEY" >
				<column name="Id" />
			</index>
			<constraint name="ck_points" type="CHECK" options="" >
				<string><![CDATA["ReservedPoints" >= 0]]></string>
			</constraint>
		</table>
