{
  "Jwt": { "Issuer": "burmalda-identity", "Audience": "burmalda-api", "SigningKey": "development-only-signing-key-change-before-use-32-chars" },
  "ClientOrigins": [ "http://localhost:5300", "https://localhost:7300" ],
  "RabbitMq": { "Host": "localhost" },
  "ReverseProxy": {
    "Routes": {
      "identity": { "ClusterId": "identity", "Match": { "Path": "/api/identity/{**catch-all}" } },
      "identity-admin": { "ClusterId": "identity", "AuthorizationPolicy": "AdminOnly", "Match": { "Path": "/api/admin/identity/{**catch-all}" } },
      "catalog": { "ClusterId": "catalog", "AuthorizationPolicy": "Default", "Match": { "Path": "/api/catalog/{**catch-all}" } },
      "catalog-admin": { "ClusterId": "catalog", "AuthorizationPolicy": "ModeratorOrAdmin", "Match": { "Path": "/api/admin/catalog/{**catch-all}" } },
      "lending": { "ClusterId": "lending", "AuthorizationPolicy": "Default", "Match": { "Path": "/api/loans/{**catch-all}" } },
      "lending-admin": { "ClusterId": "lending", "AuthorizationPolicy": "ModeratorOrAdmin", "Match": { "Path": "/api/admin/lending/{**catch-all}" } },
      "hangfire-admin": { "ClusterId": "lending", "AuthorizationPolicy": "AdminOnly", "Match": { "Path": "/hangfire/{**catch-all}" } },
      "economy": { "ClusterId": "economy", "AuthorizationPolicy": "Default", "Match": { "Path": "/api/economy/{**catch-all}" } },
      "economy-admin": { "ClusterId": "economy", "AuthorizationPolicy": "AdminOnly", "Match": { "Path": "/api/admin/economy/{**catch-all}" } },
      "reputation": { "ClusterId": "reputation", "AuthorizationPolicy": "Default", "Match": { "Path": "/api/reputation/{**catch-all}" } },
      "reputation-admin": { "ClusterId": "reputation", "AuthorizationPolicy": "ModeratorOrAdmin", "Match": { "Path": "/api/admin/reputation/{**catch-all}" } },
      "notifications": { "ClusterId": "notifications", "AuthorizationPolicy": "Default", "Match": { "Path": "/api/notifications/{**catch-all}" } },
      "notifications-admin": { "ClusterId": "notifications", "AuthorizationPolicy": "AdminOnly", "Match": { "Path": "/api/admin/notifications/{**catch-all}" } }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5101" } } },
      "catalog": { "Destinations": { "primary": { "Address": "http://localhost:5102" } } },
      "lending": { "Destinations": { "primary": { "Address": "http://localhost:5103" } } },
      "economy": { "Destinations": { "primary": { "Address": "http://localhost:5104" } } },
      "reputation": { "Destinations": { "primary": { "Address": "http://localhost:5105" } } },
      "notifications": { "Destinations": { "primary": { "Address": "http://localhost:5106" } } }
    }
  },
  "ServiceUrls": {
    "identity": "http://localhost:5101",
    "catalog": "http://localhost:5102",
    "lending": "http://localhost:5103",
    "economy": "http://localhost:5104", 
    "reputation": "http://localhost:5105", 
    "notifications": "http://localhost:5106"
  }
}
