{
  "Jwt": {
    "Issuer": "burmalda-identity",
    "Audience": "burmalda-api",
    "SigningKey": "development-only-signing-key-change-before-use-32-chars"
  },
  "ClientOrigins": [
    "http://localhost:5300",
    "https://localhost:7300"
  ],
  "RabbitMq": {
    "Host": "localhost"
  },
  "ReverseProxy": {
    "Routes": {
      "raft-lab": {
        "ClusterId": "concurrency-lab",
        "RateLimiterPolicy": "concurrency-lab",
        "Match": { "Path": "/api/raft-lab/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "identity-admin": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/admin/identity/{**catch-all}"
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "concurrency-lab": {
        "ClusterId": "concurrency-lab",
        "RateLimiterPolicy": "concurrency-lab",
        "Match": {
          "Path": "/api/concurrency-lab/{**catch-all}"
        }
      },
      "catalog-admin": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "ModeratorOrAdmin",
        "Match": {
          "Path": "/api/admin/catalog/{**catch-all}"
        }
      },
      "lending": {
        "ClusterId": "lending",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/loans/{**catch-all}"
        }
      },
      "lending-admin": {
        "ClusterId": "lending",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "ModeratorOrAdmin",
        "Match": {
          "Path": "/api/admin/lending/{**catch-all}"
        }
      },
      "hangfire-admin": {
        "ClusterId": "lending",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/hangfire/{**catch-all}"
        }
      },
      "economy": {
        "ClusterId": "economy",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/economy/{**catch-all}"
        }
      },
      "economy-admin": {
        "ClusterId": "economy",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/admin/economy/{**catch-all}"
        }
      },
      "reputation": {
        "ClusterId": "reputation",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/reputation/{**catch-all}"
        }
      },
      "reputation-admin": {
        "ClusterId": "reputation",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "ModeratorOrAdmin",
        "Match": {
          "Path": "/api/admin/reputation/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-admin": {
        "ClusterId": "notifications",
        "RateLimiterPolicy": "api",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/admin/notifications/{**catch-all}"
        }
      },
      "library-game": {
        "RateLimiterPolicy": "concurrency-lab",
        "Match": {
          "Path": "/api/library-game/{**catch-all}"
        },
        "ClusterId": "library-game",
        "AuthorizationPolicy": "Default"
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "concurrency-lab": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5107"
          }
        }
      },
      "lending": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "economy": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "reputation": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "notifications": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "library-game": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5108"
          }
        }
      }
    }
  },
  "ServiceUrls": {
    "identity": "http://localhost:5101",
    "catalog": "http://localhost:5102",
    "concurrency-lab": "http://localhost:5107",
    "lending": "http://localhost:5103",
    "economy": "http://localhost:5104",
    "reputation": "http://localhost:5105",
    "notifications": "http://localhost:5106"
  }
}
