@page "/concurrency-lab"
@implements IDisposable
@using System.Diagnostics
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>БД, транзакции и сага · Burmalda</PageTitle>

<main class="concurrency-lab">
    <header class="lab-header">
        <div>BURMALDA ЛАБОРАТОРИЯ</div>
    </header>

    <DatabaseLab />

    <section class="lab-panel" aria-labelledby="lab-controls-title">
        <div class="lab-panel-heading"><div><span class="lab-step">ЛР 2–3 / СЧЁТЧИК В ПАМЯТИ</span><h2 id="lab-controls-title">Запустить нагрузку</h2></div><span class="lab-aside">Один серверный процесс · общая память</span></div>
        <div class="lab-controls">
            <label>Клиентских запросов <input type="number" min="2" max="32" @bind="requestCount" disabled="@running" /></label>
            <label>Пауза между чтением и записью, мс <input type="number" min="10" max="2000" @bind="workDelayMs" disabled="@running" /></label>
            <button class="button button-dark" @onclick="RunComparison" disabled="@running">@(running ? "Запросы выполняются…" : "Сравнить три режима →")</button>
        </div>
        @if (liveRun is { } current)
        {
            <p class="lab-current-status" role="status">Сейчас: @RunLabel(current) · завершено @current.Snapshot.CompletedRequests из @current.Snapshot.PlannedRequests</p>
        }
        @if (!string.IsNullOrWhiteSpace(error)) { <div class="form-error" role="alert">@error</div> }
    </section>

    @if (liveRun is { } live)
    {
        <section class="lab-live" aria-labelledby="lab-live-title">
            <div class="lab-live-heading">
                <div><span class="lab-step">ВЫПОЛНЯЕТСЯ · СЕРИЯ @live.Stage ИЗ 4</span><h2 id="lab-live-title">@RunLabel(live)</h2></div>
                <span class="lab-live-time">@live.Timer.ElapsedMilliseconds мс</span>
            </div>
            <div class="lab-live-metrics">
                <div><span>На сервере сейчас</span><strong>@live.Snapshot.ActiveRequests</strong></div>
                <div><span>Завершено</span><strong>@live.Snapshot.CompletedRequests <small>/ @live.Snapshot.PlannedRequests</small></strong></div>
                <div><span>Общий счётчик</span><strong>@live.Snapshot.ActualReservations</strong></div>
                <div><span>Потеряно обновлений</span><strong>@live.Snapshot.LostUpdates</strong></div>
            </div>
            <div class="lab-live-progress" role="progressbar" aria-label="Завершённые запросы" aria-valuenow="@live.Snapshot.CompletedRequests" aria-valuemin="0" aria-valuemax="@live.Snapshot.PlannedRequests"><i style="width: @(100 * live.Snapshot.CompletedRequests / live.Snapshot.PlannedRequests)%"></i></div>
            <div class="lab-live-body">
                <div class="lab-client-grid">
                    @for (var client = 1; client <= live.Snapshot.PlannedRequests; client++)
                    {
                        var state = ClientState(live, client);
                        <div class="lab-client-state @state.CssClass">
                            <strong>Клиент @client.ToString("00")</strong>
                            <span>@state.Label</span>
                            <small>@state.Detail</small>
                        </div>
                    }
                </div>
                <div class="lab-live-events">
                    <span class="lab-step">ПОСЛЕДНИЕ СОБЫТИЯ · UTC</span>
                    @if (live.Snapshot.Events.Count == 0)
                    {
                        <p>Ожидаем первые запросы…</p>
                    }
                    else
                    {
                        @foreach (var item in live.Snapshot.Events.TakeLast(8).Reverse())
                        {
                            <p><time>@item.AtUtc.ToString("HH:mm:ss.fff")</time><span>@item.ClientId · @PhaseLabel(item.Phase)</span><b>@(item.Value?.ToString() ?? "")</b></p>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(live.PollingError)) { <div class="form-error">@live.PollingError</div> }
                </div>
            </div>
        </section>
    }

    @if (runs.Count > 0)
    {
        <section class="lab-results" aria-labelledby="lab-results-title">
            <div class="lab-panel-heading"><div><span class="lab-step">02 / СРАВНЕНИЕ</span></div><span class="lab-aside">Ожидалось = число успешно завершённых запросов</span></div>
            @if (sequentialBaseline is { } baseline)
            {
                <div class="lab-baseline"><div><span class="lab-step">КОНТРОЛЬНЫЙ ОПЫТ · ПО ОЧЕРЕДИ</span><strong>Unsafe без одновременных запросов</strong></div><div><b>@baseline.Snapshot.ActualReservations / @baseline.Snapshot.ExpectedReservations</b><small>пик @baseline.Snapshot.MaxConcurrentRequests · @baseline.ElapsedMs мс</small></div></div>
            }
            <div class="lab-result-grid">
                @foreach (var run in runs)
                {
                    <button class="lab-result-card @(selectedMode == run.Mode ? "selected" : "") @(run.Snapshot.LostUpdates > 0 ? "has-loss" : "")" @onclick="() => selectedMode = run.Mode">
                        <span class="lab-mode">@ModeLabel(run.Mode)</span>
                        <strong>@run.Snapshot.ActualReservations <small>/ @run.Snapshot.ExpectedReservations</small></strong>
                        <span class="lab-meter"><i style="width: @(run.Snapshot.ExpectedReservations == 0 ? 0 : 100 * run.Snapshot.ActualReservations / run.Snapshot.ExpectedReservations)%"></i></span>
                        <span class="lab-card-foot"><b>@(run.Snapshot.LostUpdates > 0 ? $"Потеряно {run.Snapshot.LostUpdates}" : "Потерь нет")</b><small>@run.ElapsedMs мс · пик @run.Snapshot.MaxConcurrentRequests запросов</small></span>
                    </button>
                }
            </div>
            @if (SelectedRun is { } selected)
            {
                <div class="lab-trace">
                    <div class="lab-trace-intro"><div><span class="lab-step">03 / ТРАССА</span><h3>@ModeLabel(selected.Mode)</h3></div><p>PID @selected.Snapshot.ProcessId · Старт, чтение и запись каждого запроса. Совпадающие значения чтения в режиме Race Condition показывают источник потери.</p></div>
                    <div class="lab-trace-table-wrap"><table class="lab-trace-table"><thead><tr><th>#</th><th>Время UTC</th><th>Клиент</th><th>Запрос</th><th>Фаза</th><th>Значение</th><th>Поток</th></tr></thead><tbody>
                        @foreach (var item in selected.Snapshot.Events)
                        {
                            <tr class="@(item.Phase == "wrote" ? "write-row" : "")"><td>@item.Sequence</td><td>@item.AtUtc.ToString("HH:mm:ss.fff")</td><td>@item.ClientId</td><td>@item.RequestNumber</td><td>@PhaseLabel(item.Phase)</td><td>@(item.Value?.ToString() ?? "—")</td><td>@item.ThreadId</td></tr>
                        }
                    </tbody></table></div>
                </div>
            }
        </section>
    }

    <section class="lab-panel lab-clock" aria-labelledby="lab-clock-title">
        <div class="lab-panel-heading"><div><span class="lab-step">04 / РАСПРЕДЕЛЁННОЕ ВРЕМЯ</span><h2 id="lab-clock-title">Сверить часы клиента и сервера</h2></div><span class="lab-aside">Оценка задержки в обе стороны</span></div>
        <p>Сдвиги часов моделируются в запросе и ответе. Из пяти проб выбирается та, у которой минимальная задержка: <code>offset = ((t₁ − t₀) + (t₂ − t₃)) / 2</code>.</p>
        <div class="lab-controls">
            <label>Сдвиг клиента, мс <input type="number" min="-300000" max="300000" @bind="clientSkewMs" disabled="@syncing" /></label>
            <label>Сдвиг сервера, мс <input type="number" min="-300000" max="300000" @bind="serverSkewMs" disabled="@syncing" /></label>
            <button class="button button-dark" @onclick="SynchronizeClock" disabled="@syncing">@(syncing ? "Измеряем…" : "Сверить время →")</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(clockError)) { <div class="form-error" role="alert">@clockError</div> }
        @if (bestSample is { } sample)
        {
            <div class="lab-clock-results">
                <div><span>Смещение сервера относительно клиента</span><strong>@Signed(sample.OffsetMs) мс</strong></div>
                <div><span>Оценка сетевой задержки RTT</span><strong>@sample.NetworkRttMs.ToString("0.0") мс</strong></div>
                <div><span>Синхронизированные часы клиента</span><strong>@(DateTimeOffset.UtcNow.AddMilliseconds(measuredClientSkewMs + sample.OffsetMs).ToString("HH:mm:ss")) UTC</strong></div>
            </div>
            <p class="lab-hint">t₀ и t₃ измерены на клиенте; t₁ и t₂ — на сервере. Коррекция приблизительная: она предполагает близкие задержки туда и обратно. Сдвиг не меняет системные часы устройства.</p>
        }
    </section>
</main>

@code {
    private int requestCount = 12;
    private int workDelayMs = 60;
    private int clientSkewMs = 90_000;
    private int serverSkewMs = -45_000;
    private bool running;
    private bool syncing;
    private string? error;
    private string? clockError;
    private readonly List<LabRun> runs = [];
    private LabRun? sequentialBaseline;
    private LiveExperiment? liveRun;
    private CancellationTokenSource? runCancellation;
    private ReservationMode selectedMode = ReservationMode.Unsafe;
    private ClockMeasurement? bestSample;
    private int measuredClientSkewMs;
    private System.Threading.Timer? clockTimer;
    private LabRun? SelectedRun => runs.FirstOrDefault(x => x.Mode == selectedMode);

    private async Task RunComparison()
    {
        error = null;
        if (requestCount is < 2 or > 32 || workDelayMs is < 10 or > 2000)
        { error = "Допустимо 2–32 запроса и пауза 10–200 мс."; return; }
        running = true;
        runs.Clear();
        sequentialBaseline = null;
        using var cancellation = new CancellationTokenSource();
        runCancellation = cancellation;
        try
        {
            sequentialBaseline = await RunExperiment(ReservationMode.Unsafe, false, cancellation.Token);
            StateHasChanged();
            foreach (var mode in Enum.GetValues<ReservationMode>())
            {
                runs.Add(await RunExperiment(mode, true, cancellation.Token));
                StateHasChanged();
            }
            selectedMode = ReservationMode.Unsafe;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        { error = $"Не удалось завершить сравнение: {ex.Message}. Проверьте запуск gateway и ConcurrencyLab API."; }
        finally { running = false; liveRun = null; runCancellation = null; }
    }

    private async Task<LabRun> RunExperiment(ReservationMode mode, bool parallel, CancellationToken ct)
    {
        using var create = await Http.PostAsJsonAsync("/api/concurrency-lab/experiments",
            new { mode, plannedRequests = requestCount, workDelayMs, startTogether = parallel }, ct);
        await EnsureSuccess(create);
        var created = await create.Content.ReadFromJsonAsync<ExperimentSnapshot>() ?? throw new InvalidOperationException("Пустой ответ сервера.");
        var timer = Stopwatch.StartNew();
        var live = new LiveExperiment(mode, parallel, created, timer);
        liveRun = live;
        await InvokeAsync(StateHasChanged);
        using var pollCancellation = CancellationTokenSource.CreateLinkedTokenSource(ct);
        var polling = PollLiveAsync(live, pollCancellation.Token);
        try
        {
            if (parallel)
                await Task.WhenAll(Enumerable.Range(1, requestCount).Select(i => SendReserve(created.Id, i, live, ct)));
            else
                for (var i = 1; i <= requestCount; i++) await SendReserve(created.Id, i, live, ct);
        }
        finally
        {
            pollCancellation.Cancel();
            await polling;
        }
        timer.Stop();
        var snapshot = await Http.GetFromJsonAsync<ExperimentSnapshot>($"/api/concurrency-lab/experiments/{created.Id}", ct)
            ?? throw new InvalidOperationException("Нет результата эксперимента.");
        live.Snapshot = snapshot;
        await InvokeAsync(StateHasChanged);
        liveRun = null;
        return new LabRun(mode, snapshot, timer.ElapsedMilliseconds);
    }

    private async Task PollLiveAsync(LiveExperiment live, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(180));
            while (await timer.WaitForNextTickAsync(ct))
            {
                var snapshot = await Http.GetFromJsonAsync<ExperimentSnapshot>(
                    $"/api/concurrency-lab/experiments/{live.Snapshot.Id}", ct);
                if (snapshot is null) throw new InvalidOperationException("Пустой снимок эксперимента.");
                if (ReferenceEquals(liveRun, live))
                {
                    live.Snapshot = snapshot;
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException)
        {
            live.PollingError = $"Живые обновления прерваны: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendReserve(Guid id, int i, LiveExperiment live, CancellationToken ct)
    {
        live.DispatchedRequests++;
        using var response = await Http.PostAsJsonAsync($"/api/concurrency-lab/experiments/{id}/reserve", new { clientId = $"Клиент {i:00}" }, ct);
        await EnsureSuccess(response);
    }

    private async Task SynchronizeClock()
    {
        clockError = null;
        if (clientSkewMs is < -300_000 or > 300_000 || serverSkewMs is < -300_000 or > 300_000)
        { clockError = "Сдвиг должен быть в пределах ±300 000 мс."; return; }
        syncing = true;
        bestSample = null;
        measuredClientSkewMs = clientSkewMs;
        try
        {
            for (var i = 0; i < 5; i++)
            {
                var t0 = DateTimeOffset.UtcNow.AddMilliseconds(clientSkewMs);
                using var response = await Http.GetAsync($"/api/concurrency-lab/time?serverSkewMs={serverSkewMs}&processingMs=20");
                var t3 = DateTimeOffset.UtcNow.AddMilliseconds(clientSkewMs);
                await EnsureSuccess(response);
                var server = await response.Content.ReadFromJsonAsync<TimeSample>() ?? throw new InvalidOperationException("Нет временных меток сервера.");
                var offset = ((server.ServerReceivedAtUtc - t0).TotalMilliseconds + (server.ServerSentAtUtc - t3).TotalMilliseconds) / 2;
                var rtt = (t3 - t0).TotalMilliseconds - (server.ServerSentAtUtc - server.ServerReceivedAtUtc).TotalMilliseconds;
                var measurement = new ClockMeasurement(offset, rtt);
                if (bestSample is null || measurement.NetworkRttMs < bestSample.NetworkRttMs) bestSample = measurement;
            }
            clockTimer?.Dispose();
            clockTimer = new System.Threading.Timer(state => { _ = InvokeAsync(StateHasChanged); }, null,
                TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException)
        { clockError = $"Не удалось сверить часы: {ex.Message}"; }
        finally { syncing = false; }
    }

    private static Task EnsureSuccess(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode) return Task.CompletedTask;
        throw new HttpRequestException($"HTTP {(int)response.StatusCode}");
    }

    private static string ModeLabel(ReservationMode mode) => mode switch
    {
        ReservationMode.Unsafe => "Race Condition · ЛР 2",
        ReservationMode.Lock => "lock · ЛР 3",
        _ => "SemaphoreSlim · ЛР 3"
    };
    private static string PhaseLabel(string phase) => phase switch
    {
        "started" => "Принят", "barrier" => "Барьер старта", "waiting" => "Ждёт доступ",
        "read" => "Чтение", "wrote" => "Запись", "start-timeout" => "Ожидание истекло", _ => phase
    };
    private static string RunLabel(LiveExperiment live) => live.Parallel
        ? ModeLabel(live.Mode) : "Последовательно · Unsafe";
    private static ClientProgress ClientState(LiveExperiment live, int client)
    {
        var latest = live.Snapshot.Events.LastOrDefault(x => x.ClientId == $"Клиент {client:00}");
        if (latest is null)
            return client <= live.DispatchedRequests
                ? new ClientProgress("sent", "Отправлен", "Ожидает сервер")
                : new ClientProgress("pending", "В очереди", "Ещё не отправлен");
        return latest.Phase switch
        {
            "started" => new ClientProgress("accepted", "Принят", $"Запрос №{latest.RequestNumber}"),
            "barrier" => new ClientProgress("waiting", "На барьере", "Ждёт другие запросы"),
            "waiting" => new ClientProgress("waiting", "Ждёт доступ", "Критическая секция занята"),
            "read" => new ClientProgress("working", "Работает", $"Прочитал {latest.Value}"),
            "wrote" => new ClientProgress("done", "Завершён", $"Записал {latest.Value}"),
            "start-timeout" => new ClientProgress("accepted", "Продолжает", "Барьер отпущен по времени"),
            _ => new ClientProgress("accepted", latest.Phase, "На сервере")
        };
    }
    private static string Signed(double value) => value >= 0 ? $"+{value:0.0}" : $"{value:0.0}";

    private enum ReservationMode { Unsafe, Lock, SemaphoreSlim }
    private sealed record ClientProgress(string CssClass, string Label, string Detail);
    private sealed class LiveExperiment(ReservationMode mode, bool parallel, ExperimentSnapshot snapshot, Stopwatch timer)
    {
        public ReservationMode Mode { get; } = mode;
        public bool Parallel { get; } = parallel;
        public int Stage => Parallel ? (int)Mode + 2 : 1;
        public ExperimentSnapshot Snapshot { get; set; } = snapshot;
        public Stopwatch Timer { get; } = timer;
        public int DispatchedRequests { get; set; }
        public string? PollingError { get; set; }
    }
    private sealed record LabRun(ReservationMode Mode, ExperimentSnapshot Snapshot, long ElapsedMs);
    private sealed record ReservationEvent(long Sequence, int RequestNumber, string ClientId, string Phase, DateTimeOffset AtUtc, int ThreadId, int? Value);
    private sealed record ExperimentSnapshot(Guid Id, ReservationMode Mode, bool StartTogether, int PlannedRequests, int WorkDelayMs,
        int AcceptedRequests, int CompletedRequests, int ExpectedReservations, int ActualReservations,
        int LostUpdates, int ActiveRequests, int MaxConcurrentRequests, int ProcessId, List<ReservationEvent> Events);
    private sealed record TimeSample(DateTimeOffset ServerReceivedAtUtc, DateTimeOffset ServerSentAtUtc, int ServerSkewMs);
    private sealed record ClockMeasurement(double OffsetMs, double NetworkRttMs);
    public void Dispose()
    {
        runCancellation?.Cancel();
        clockTimer?.Dispose();
    }
}
