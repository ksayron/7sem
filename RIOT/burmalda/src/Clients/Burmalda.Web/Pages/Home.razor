@page "/"
@inject AuthSession Auth

<PageTitle>Burmalda Доброта · Books in motion</PageTitle>

<section class="hero-grid">
    <div class="hero-copy reveal">
        <span class="eyebrow">A NEIGHBOURHOOD LIBRARY WITHOUT WALLS</span>
        <h1>Pass a story.<br /><em>Grow a community.</em></h1>
        <p class="hero-lede">Share the books resting on your shelf, discover a reader nearby, and keep generosity moving with Burmalda Доброта points.</p>
        <div class="hero-actions">
            @if (Auth.IsAuthenticated)
            {
                <a class="button button-primary" href="discover">Find your next book <span>→</span></a>
                <a class="text-link" href="shelf">List a book you own</a>
            }
            else
            {
                <a class="button button-primary" href="register">Join the exchange <span>→</span></a>
                <a class="text-link" href="login">I already have an account</a>
            }
        </div>
        <div class="trust-row">
            <div><strong>01</strong><span>List a copy</span></div>
            <div><strong>02</strong><span>Lend nearby</span></div>
            <div><strong>03</strong><span>Earn kindness</span></div>
        </div>
    </div>
    <div class="hero-art reveal reveal-late" aria-label="Illustrated stack of community books">
        <div class="sun-disc"></div>
        <div class="book-stack">
            <div class="book book-one"><span>The Master<br />and Margarita</span><b>8 BD</b></div>
            <div class="book book-two"><span>Beloved</span><b>5 BD</b></div>
            <div class="book book-three"><span>The Hobbit</span><b>12 BD</b></div>
            <div class="book book-four"><span>Solaris</span><b>7 BD</b></div>
        </div>
        <div class="art-note">Four shelves.<br />One shared story.</div>
        <div class="orbit-label">MINSK · COMMUNITY COPY № 042</div>
    </div>
</section>

<section class="manifesto-strip">
    <span>OWNED BY READERS</span><i>◆</i><span>POWERED BY TRUST</span><i>◆</i><span>REWARDED IN BD</span><i>◆</i><span>BUILT TO CIRCULATE</span>
</section>

<section class="feature-editorial">
    <div>
        <span class="section-index">I.</span>
        <h2>Your shelf is<br />already a library.</h2>
    </div>
    <div class="feature-copy">
        <p>Every physical copy has its own condition, place, price, and story. You decide what travels—and for how long.</p>
        <div class="mini-features">
            <article><span>▥</span><h3>List precisely</h3><p>ISBN, condition, location, and terms stay attached to each copy.</p></article>
            <article><span>⇄</span><h3>Handover safely</h3><p>Time-bound codes confirm that the right book reached the right reader.</p></article>
            <article><span>◉</span><h3>Build trust</h3><p>Returns, reliability, and community care shape your reputation.</p></article>
        </div>
    </div>
</section>
