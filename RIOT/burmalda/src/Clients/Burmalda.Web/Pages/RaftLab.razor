@page "/raft-lab"
@implements IAsyncDisposable
@using System.Net.Http.Json
@using System.Text.Json
@using Burmalda.Web.Models
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Raft · управление PostgreSQL · Burmalda</PageTitle>
<main class="raft-lab">
    <header class="raft-heading">
        <h1>Пять голосов.<br /><em>Одна история.</em></h1>
        <div><p>Raft управляет переключением PostgreSQL. Книги и экземпляры остаются в Catalog; управляющие узлы сохраняют решения в пяти отдельных журналах.</p><a href="replication-lab">Открыть репликацию и книги каталога</a></div>
    </header>
    <div class="raft-toolbar">
        <button class="button" disabled="@busy" @onclick="Refresh">Обновить наблюдения</button>
        <a class="button" href="#" @onclick="Download" @onclick:preventDefault download="raft-status.json">Скачать JSON состояния</a>
        <span role="status">@(snapshot is null ? "Подключаем управляющие узлы…" : $"Наблюдение: {snapshot.ObservedAtUtc.ToLocalTime():HH:mm:ss}")</span>
    </div>
    @if(error is not null) { <p class="raft-error" role="alert">@error</p> }
    @if(snapshot is {} view)
    {
        <section class="raft-summary" aria-label="Подтверждение управления">
            <h2>@(view.Authoritative is not null ? $"Лидер Node {view.Authoritative.Node.NodeId} · term {view.Authoritative.Node.Term}" : "Лидерство не подтверждено большинством")</h2>
            <p data-testid="raft-quorum">@(view.Authoritative is not null ? "Свежий обмен с кворумом подтверждён. Требуется 3 из 5." : "Новые управляющие решения не подтверждены. Работа исправного PostgreSQL может продолжаться.")</p>
            @if(view.Error is not null) { <p class="raft-note">@view.Error</p> }
        </section>
        <RaftScene @ref="scene" Busy="busy" CanCommand="@(view.Authoritative is not null && view.State?.ActiveOperation is null)" ReplayChanged="ReplayChanged" ProcessNode="SceneProcess" Partition="Partition" Heal="Heal" Synchronize="SceneSynchronize" />
        <section aria-labelledby="raft-nodes-title">
            <div class="raft-section-heading"><h2 id="raft-nodes-title">Управляющие узлы</h2><span>Роль — собственное наблюдение каждого узла</span></div>
            <div class="raft-scroll" tabindex="0" aria-label="Состояние пяти узлов">
                <table data-testid="raft-nodes"><thead><tr><th>Узел</th><th>Состояние / роль</th><th>Term</th><th>Commit / Applied</th><th>Журнал / Snapshot</th><th>Процесс</th><th>Исходящая связь</th></tr></thead><tbody>
                    @foreach(var node in view.Nodes)
                    {
                        <tr data-node="@node.NodeId">
                            <th scope="row">Node @node.NodeId</th>
                            <td><strong class="@(node.Available ? "raft-good" : "raft-bad")">@(node.Available ? node.State?.Role : "Недоступен")</strong></td>
                            <td>@node.State?.Term</td><td>@node.State?.CommitIndex / @node.State?.LastApplied</td><td>@node.State?.LastLogIndex / @node.State?.SnapshotIndex</td>
                            <td><button class="button button-small" disabled="@(busy || replaying)" @onclick='() => Process(node.NodeId,node.Available ? "Stop" : "Start")'>@(node.Available ? "Остановить" : "Запустить")</button></td>
                            <td><button class="button button-small" disabled="@(busy || replaying || !node.Available)" @onclick="() => Fault(node.NodeId,[],1200,0)">Задержка 1,2 с</button><button class="button button-small" disabled="@(busy || replaying || !node.Available)" @onclick="() => Fault(node.NodeId,[],0,3)">Терять ⅓ сообщений</button></td>
                        </tr>
                    }
                </tbody></table>
            </div>
            <div class="raft-toolbar"><button class="button" disabled="@(busy || replaying)" @onclick="Partition">Разделить сеть 3 + 2</button><button class="button" disabled="@(busy || replaying)" @onclick="Heal">Восстановить связь</button></div>
            <p class="raft-note">Разделение изолирует текущего лидера с одним соседом. Остановка выключает узел: контейнер при запуске через Docker или C#-процесс при локальной отладке. Изменения связи сохраняют доступ к диагностическому API.</p>
        </section>
        <section aria-labelledby="raft-postgres-title">
            <h2 id="raft-postgres-title">PostgreSQL: фактическое состояние</h2>
            <div class="raft-postgres">
                @foreach(var pg in view.Postgres)
                {
                    <article><h3>@pg.Id</h3><p><strong>@pg.Role</strong> · @pg.State · @(pg.ReadOnly ? "read-only" : "read/write")</p><p>WAL <code>@(pg.WalLsn ?? "—")</code><br />Replay <code>@(pg.ReplayLsn ?? "—")</code> · @(pg.ReplayPaused ? "PAUSED" : pg.StreamingState ?? "нет наблюдения")</p>
                        <p>@pg.Books.Count книг · @pg.Copies.Count экземпляров</p>
                        @if(pg.Error is not null) { <p class="raft-note">@pg.Error</p> }
                        <button class="button button-small" disabled="@(busy || replaying || view.Authoritative is null || pg.Role=="Primary")" @onclick='() => Operate("Recover",pg.Id)'>Восстановить узел</button>
                    </article>
                }
            </div>
            <div class="raft-toolbar"><button class="button button-primary" disabled="@(busy || replaying || view.Authoritative is null || view.State?.Initialized!=true || view.State?.ActiveOperation is not null)" @onclick='() => Operate("Switchover")'>Переключить primary</button><button class="button" disabled="@(busy || replaying || view.Authoritative is null)" @onclick='() => Operate("Pause")'>Приостановить replay</button><button class="button" disabled="@(busy || replaying || view.Authoritative is null)" @onclick='() => Operate("Synchronize")'>Возобновить и дождаться WAL</button></div>
            <p class="raft-note">Переключение затрагивает все базы Burmalda. Async-репликация сохранена: без fencing и доказанной границы WAL promotion запрещён.</p>
            @if(view.State is {} cluster)
            { <p>Primary в подтверждённой истории: <strong>@(cluster.Primary ?? "не назначен")</strong> · fencing: @(cluster.FencedSource ?? "нет") · требуемый WAL: <code>@(cluster.RequiredLsn ?? "—")</code></p> }
            @foreach(var diagnostic in view.Diagnostic)
            { if(diagnostic.TryGetProperty("controlError",out var ce) && ce.ValueKind==JsonValueKind.String) { <p class="raft-error">@ce.GetString()</p> } }
        </section>
        @if(pending is not null)
        { <p class="raft-note" role="status">Команда <code>@pending.CommandId</code>. Если исход неизвестен, проверяйте этот ID и повторяйте только ту же команду.<button class="button button-small" disabled="@(busy || replaying)" @onclick="RetryPending">Повторить прежний запрос</button><button class="button button-small" disabled="@busy" @onclick="CheckPending">Проверить результат</button></p> }
        <section aria-labelledby="raft-operations-title"><h2 id="raft-operations-title">Операции переключения</h2>
            @if(view.State?.Operations.Count>0)
            {
                <div class="raft-scroll" tabindex="0" aria-label="Согласованные операции"><table><thead><tr><th>Команда</th><th>Операция</th><th>Состояние</th><th>Этап</th><th>Source → Target</th><th>Результат</th></tr></thead><tbody>
                    @foreach(var op in view.State.Operations.Values.Reverse().Take(30))
                    { <tr><td><code title="@op.Request.CommandId">@op.Request.CommandId.ToString()[..8]</code></td><td>@op.Request.Kind</td><td>@op.Status</td><td>@op.Stage</td><td>@op.Source → @op.Target</td><td>@(op.Error ?? op.Value ?? "—")</td></tr> }
                </tbody></table></div>
            }
            else { <p class="raft-note">@(view.Authoritative is null ? "Подтверждённая история операций сейчас недоступна." : "Операций пока нет. Можно проверить отказы управляющих без изменения PostgreSQL.")</p> }
        </section>
        <section aria-labelledby="raft-log-title">
            <div class="raft-section-heading"><h2 id="raft-log-title">Журнал Raft</h2><label>Наблюдать узел <select @bind="selectedNode" @bind:after="ResetPages">@foreach(var n in view.Nodes){<option value="@n.NodeId">Node @n.NodeId</option>}</select></label></div>
            <p class="raft-note">Persisted — записано локально; committed — подтверждено; applied — применено. Снимок заменяет записи до индекса @(log?.SnapshotIndex ?? 0). Локальные наблюдения могут отставать.</p>
            <div class="raft-scroll" tabindex="0" aria-label="Журнал Raft"><table data-testid="raft-log"><thead><tr><th>Index</th><th>Term</th><th>Command ID</th><th>Persisted</th><th>Committed</th><th>Applied</th><th>Содержимое</th></tr></thead><tbody>
                @foreach(var row in log?.Entries??[])
                { <tr><td>@row.Index</td><td>@row.Term</td><td><code>@(row.CommandId?.ToString()[..8]??"no-op")</code></td><td>@row.Persisted</td><td>@row.Committed</td><td>@row.Applied</td><td><details><summary>@(row.Payload is null ? "Подтверждение срока лидерства" : "Команда управления")</summary><pre>@row.Payload</pre></details></td></tr> }
            </tbody></table></div>
            <div class="raft-toolbar"><button class="button button-small" disabled="@busy" @onclick="ResetPages">С начала сохранённого журнала</button><button class="button button-small" disabled="@(busy || log?.Entries.Length!=100)" @onclick="NextLog">Следующие 100 записей</button></div>
        </section>
        <section aria-labelledby="raft-events-title"><h2 id="raft-events-title">События Node @selectedNode</h2>
            <div class="raft-scroll" tabindex="0" aria-label="События Raft"><table><thead><tr><th>UTC</th><th>Term</th><th>Событие</th><th>Подробности</th></tr></thead><tbody>
                @foreach(var e in events?.Events??[]){<tr><td>@e.AtUtc.ToString("HH:mm:ss.fff")</td><td>@e.Term</td><td>@e.Kind</td><td>@e.Detail</td></tr>}
            </tbody></table></div><p class="raft-note">События — ограниченный диагностический буфер процесса; решения сохраняются в SQLite и снимках.</p>
            <button class="button button-small" disabled="@(busy || events?.Events.Length!=100)" @onclick="NextEvents">Следующие 100 событий</button>
        </section>
    }
</main>

@code {
    private RaftLabSnapshot? snapshot;
    private RaftLogPage? log;
    private RaftEventPage? events;
    private RaftOperationRequest? pending;
    private readonly CancellationTokenSource stop=new();
    private Task? poll;
    private bool busy;
    private string? error;
    private int selectedNode=1;
    private long logAfter,eventAfter;
    private RaftScene? scene;
    private bool replaying;
    private Task ReplayChanged(bool value){replaying=value;return Task.CompletedTask;}
    private Task SceneProcess(int id)=>Process(id,snapshot?.Nodes.FirstOrDefault(n=>n.NodeId==id)?.Available==true?"Stop":"Start");
    private Task SceneSynchronize()=>Operate("Synchronize");
    private async Task Download()
    {
        var json=JsonSerializer.Serialize(new {snapshot,log,events,visualization=scene?.Export()});
        await using var module=await JS.InvokeAsync<IJSObjectReference>("import","./js/raft-export.js");
        await module.InvokeVoidAsync("download",json);
    }
    protected override async Task OnInitializedAsync(){await Refresh();poll=Poll();}
    private async Task Poll()
    {
        try { while(!stop.IsCancellationRequested){await Task.Delay(2000,stop.Token);await InvokeAsync(Refresh);} }
        catch(OperationCanceledException) { }
    }
    private async Task Load()
    {
        snapshot=await Http.GetFromJsonAsync<RaftLabSnapshot>("api/raft-lab/status",stop.Token);
        if(snapshot?.Nodes.Single(x=>x.NodeId==selectedNode).Available==true)
        {
            log=await Http.GetFromJsonAsync<RaftLogPage>($"api/raft-lab/log?nodeId={selectedNode}&after={logAfter}",stop.Token);
            events=await Http.GetFromJsonAsync<RaftEventPage>($"api/raft-lab/events?nodeId={selectedNode}&after={eventAfter}",stop.Token);
        }
        else { log=null;events=null; }
    }
    private async Task Refresh(){if(busy)return;await Guard(Load);}
    private async Task Guard(Func<Task> action)
    {
        busy=true;error=null;
        try { await action(); }
        catch(Exception e) when(e is HttpRequestException or TaskCanceledException or JsonException or InvalidOperationException){if(!stop.IsCancellationRequested)error=e.Message;}
        finally { busy=false;StateHasChanged(); }
    }
    private async Task Post(string route,object body)
    {
        if(replaying)throw new InvalidOperationException("Вернитесь в прямой эфир перед изменением кластера.");
        using var response=await Http.PostAsJsonAsync("api/raft-lab/"+route,body,stop.Token);
        if(!response.IsSuccessStatusCode)throw new HttpRequestException(await response.Content.ReadAsStringAsync(stop.Token));
    }
    private Task Process(int id,string action)=>Guard(async()=>{await Post("processes",new {nodeId=id,action});await Load();});
    private Task Fault(int id,int[] blocked,int delay,int drop)=>Guard(async()=>{await Post($"faults/{id}",new {blocked,delayMs=delay,dropEvery=drop});await Load();});
    private Task Partition()=>Guard(async()=>
    {
        var leader=snapshot?.Authoritative?.Node.NodeId??1;
        var minority=new[]{leader,leader==5?4:5};
        foreach(var id in Enumerable.Range(1,5))await Post($"faults/{id}",new {blocked=Enumerable.Range(1,5).Where(x=>minority.Contains(x)!=minority.Contains(id)).ToArray()});
        await Load();
    });
    private Task Heal()=>Guard(async()=>{foreach(var n in snapshot?.Nodes.Where(x=>x.Available)??[])await Post($"faults/{n.NodeId}",new {blocked=Array.Empty<int>()});await Load();});
    private Task Operate(string kind,string? node=null)=>Guard(async()=>{pending=new(Guid.NewGuid(),kind,node);await Post("operations",pending);await Load();});
    private Task RetryPending()=>Guard(async()=>{if(pending is not null)await Post("operations",pending);await Load();});
    private Task CheckPending()=>Guard(async()=>
    {
        if(pending is null)return;
        var result=await Http.GetFromJsonAsync<RaftOperation>($"api/raft-lab/operations/{pending.CommandId}",stop.Token);
        if(result?.Status is "Completed" or "Failed" or "NeedsInspection")pending=null;
        await Load();
    });
    private Task ResetPages(){logAfter=eventAfter=0;return Refresh();}
    private Task NextLog(){logAfter=log?.Entries.LastOrDefault()?.Index??0;return Refresh();}
    private Task NextEvents(){eventAfter=events?.Events.LastOrDefault()?.Sequence??0;return Refresh();}
    public async ValueTask DisposeAsync(){stop.Cancel();if(poll is not null)await poll;stop.Dispose();}
}
