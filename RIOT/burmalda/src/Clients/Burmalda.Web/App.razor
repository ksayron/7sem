@inject IConfiguration Configuration
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (!Configuration.GetValue<bool>("Features:LearningLabs") && IsLearningPage(routeData.PageType))
        {
            <LayoutView Layout="@typeof(MainLayout)">
                <section class="empty-state"><h1>Page unavailable</h1><p>Learning labs are disabled in this environment.</p><a href="">Return home</a></section>
            </LayoutView>
        }
        else
        {
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        }
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Page not found · Burmalda</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <section class="empty-state">
                <span class="eyebrow">404 · MISPLACED CHAPTER</span>
                <h1>This page wandered off the shelf.</h1>
                <p>The link may be old, or the story may have moved.</p>
                <a class="button button-primary" href="">Return home</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static bool IsLearningPage(Type type) => type.GetCustomAttributes(typeof(RouteAttribute), true)
        .Cast<RouteAttribute>().Any(route => new[] { "/concurrency-lab", "/replication-lab", "/pubsub-lab", "/raft-lab", "/library-game" }.Contains(route.Template));
}
